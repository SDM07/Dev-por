# Copia este archivo a .env.local para desarrollo local.
# true = usa datos de ejemplo y omite Azure AD (solo desarrollo).
VITE_USE_MOCKS=true

# Azure AD (App Registration del SPA)
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Scope expuesto por la App Registration de la API, ej: api://<api-client-id>/Portal.Read
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/Portal.Read
# Nombre del app role de administradores
VITE_ADMIN_ROLE=Portal.Admin

# Base de la API. En AWS es relativa (/api) porque CloudFront enruta /api/* a API Gateway.
VITE_API_BASE_URL=/api
